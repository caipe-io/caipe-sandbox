{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "extraContainers": {"type": "array", "items": {"type": "object"}},
    "extraVolumes": {"type": "array", "items": {"type": "object"}},
    "extraServicePorts": {"type": "array", "items": {"type": "object"}},
    "extraObjects": {
      "type": "array",
      "items": {"type": "object"}
    },
    "agentSandbox": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "omnigent": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "kata": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "observability": {
      "type": "object", "additionalProperties": false,
      "required": ["tracing"],
      "properties": {
        "tracing": {
          "type": "object", "additionalProperties": false,
          "required": ["endpoint", "sampleRatio"],
          "properties": {
            "endpoint": {"type": "string", "pattern": "^$|^https?://[^@?# ]+$"},
            "sampleRatio": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "openShell": {
      "description": "Native values for the optional upstream OpenShell gateway chart.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "podDisruptionBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"anyOf": [{"$ref": "#/definitions/IntOrPercent"}, {"type": "null"}]},
        "maxUnavailable": {"anyOf": [{"$ref": "#/definitions/IntOrPercent"}, {"type": "null"}]}
      }
    },
    "topologySpreadConstraints": {
      "type": "array", "items": {"type": "object"}
    },
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 6, "maximum": 900},
    "shutdown": {
      "type": "object", "additionalProperties": false,
      "required": ["propagationSeconds", "drainSeconds", "serverGraceSeconds"],
      "properties": {
        "propagationSeconds": {"type": "integer", "minimum": 0, "maximum": 60},
        "drainSeconds": {"type": "integer", "minimum": 0, "maximum": 600},
        "serverGraceSeconds": {"type": "integer", "minimum": 5, "maximum": 120}
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "allowedStrategies": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "perUser",
              "perSandbox"
            ]
          }
        },
        "strategy": {
          "type": "string",
          "enum": [
            "perUser",
            "perSandbox"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "agentSandbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec"
            ],
            "properties": {
              "spec": {
                "type": "object"
              }
            }
          },
          "helpers": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "script"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,39}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "icon": {
                  "type": "string",
                  "enum": [
                    "terminal",
                    "code",
                    "git",
                    "package",
                    "folder",
                    "file",
                    "logs",
                    "key",
                    "play",
                    "refresh",
                    "download",
                    "upload",
                    "settings",
                    "info",
                    "external",
                    "server",
                    "database",
                    "network",
                    "globe",
                    "shield",
                    "disk",
                    "cpu",
                    "memory",
                    "box",
                    "claude",
                    "codex",
                    "caipe",
                    "omnigent"
                  ]
                },
                "script": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "status": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          },
          "terminal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\x00\\r\\n]*$"
                }
              }
            }
          },
          "ui": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "resources": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/ResourceControls"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "openShell": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec"
            ],
            "properties": {
              "spec": {
                "type": "object"
              }
            }
          },
          "acp": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "workspace_root"
            ],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "workspace_root": {
                "type": "string",
                "pattern": "^/[^\\x00\\r\\n]+$",
                "maxLength": 1024
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "agentSandbox"
            ],
            "not": {
              "required": [
                "openShell"
              ]
            }
          },
          {
            "required": [
              "openShell"
            ],
            "not": {
              "required": [
                "agentSandbox"
              ]
            }
          }
        ]
      }
    },
    "defaultProfile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "settings": {
      "type": "object",
      "properties": {
        "headerLinks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2083,
                "pattern": "^https?://[^\\s]+$"
              }
            }
          }
        },
        "maxSandboxesPerUser": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeClass": {
          "type": "string",
          "minLength": 0,
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "allowedRuntimeClasses": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 253,
                "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              }
            }
          ]
        },
        "origin": {
          "type": "string"
        },
        "terminalUrl": {
          "type": "string",
          "pattern": "^$|^wss?://[^@?# ]+[^/]$"
        },
        "namespacePrefix": {
          "type": "string"
        },
        "runnerServiceAccount": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "basePath": {
          "type": "string"
        },
        "runnerImagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sandboxSecurityContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runAsUser",
            "runAsGroup",
            "fsGroup"
          ],
          "properties": {
            "runAsUser": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "fsGroup": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        "openShell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https://[^/]+/?$"
            },
            "gatewayId": {
              "type": "string"
            },
            "gatewayServiceAccount": {
              "type": "string"
            },
            "sandboxServiceAccount": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "storageGiB": {
              "type": "integer",
              "minimum": 1
            },
            "storageMode": {
              "type": "string",
              "enum": ["gateway", "persistentVolumeClaim"]
            },
            "namespaceLabel": {
              "type": "string"
            },
            "gatewayPodSelector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            },
            "supervisorResources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      ]
                    },
                    "memory": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      ]
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      ]
                    },
                    "memory": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "operationLeaseSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        },
        "terminalIoWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "reconcileIntervalSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sandboxSecurityContext"
      ]
    },
    "image": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "ingress": {
      "type": "object"
    },
    "namespacePolicy": {
      "type": "object",
      "properties": {
        "baselineNetworkPolicy": {"type": "boolean"}
      }
    },
    "resourcePolicy": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["oidc", "omnigent", "caipe"]},
        "caipe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {"type": "string", "minLength": 1},
            "app_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
            "default_role": {"enum": ["user", "viewer"]},
            "session_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
            "existingSecret": {"type": "string"},
            "verificationKeyKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "existingSecret",
        "secretKey",
        "caSecret",
        "persistence"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "caSecret": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "storageClass"
          ],
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "rollingUpdate": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "maxUnavailable",
            "maxSurge"
          ],
          "properties": {
            "maxUnavailable": {
              "$ref": "#/definitions/IntOrPercent"
            },
            "maxSurge": {
              "$ref": "#/definitions/IntOrPercent"
            }
          }
        }
      }
    },
    "acp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "connections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "owner_subject",
              "sandbox_name",
              "sandbox_uid",
              "policy_revision"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 254
              },
              "owner_subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 254
              },
              "sandbox_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 36
              },
              "sandbox_uid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "policy_revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "IntOrPercent": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(100|[0-9]{1,2})%$"
        }
      ]
    },
    "ComputeResources": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        },
        "memory": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "cpu",
        "memory"
      ],
      "type": "object"
    },
    "ResourceControls": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/ResourceValues"
        },
        "minimum": {
          "$ref": "#/definitions/ResourceValues"
        },
        "maximum": {
          "$ref": "#/definitions/ResourceValues"
        }
      },
      "required": [
        "default",
        "minimum",
        "maximum"
      ],
      "type": "object"
    },
    "ResourceValues": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/ComputeResources"
        },
        "limits": {
          "$ref": "#/definitions/ComputeResources"
        },
        "storage": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "requests",
        "limits",
        "storage"
      ],
      "type": "object"
    }
  }
}
